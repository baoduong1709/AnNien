# ===================================================
# AnNien Backend Proxy Gateway Environment Variables
# ===================================================

# Google Gemini API Key (Required for Live API, Flash, and Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Models (Configured according to AnNien specs)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live
GEMINI_LIVE_MODEL_FALLBACK=gemini-2.0-flash-exp
GEMINI_FLASH_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-005

# Google Cloud Run Deployment
GCP_PROJECT_ID=annien-care
GCP_LOCATION=asia-southeast1
PORT=8080

# Voice selection for live conversation: Aoede, Puck, Charon, Fenrir, Kore
LIVE_VOICE_NAME=Aoede

# Emergency Contacts
PRIMARY_CAREGIVER_NAME=Bao Duong
PRIMARY_CAREGIVER_PHONE=0912345678
EMERGENCY_CONTACT_PHONE=115
